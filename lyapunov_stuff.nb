Notebook[{
Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Define", " ", "parameters"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"q", "=", 
     RowBox[{"\[Omega]", "/", 
      RowBox[{"gfb", "^", "2"}]}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", "Matrices", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"A", "=", 
     RowBox[{"\[Omega]", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", "0"}], "}"}]}], "}"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"B", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"K", "=", 
     RowBox[{"\[Omega]", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"Sqrt", "[", 
            RowBox[{"1", "+", 
             RowBox[{"1", "/", 
              RowBox[{"(", 
               RowBox[{"\[Omega]", " ", "q"}], ")"}]}]}], "]"}], "-", "1"}], 
          ",", 
          RowBox[{"Sqrt", "[", 
           RowBox[{
            RowBox[{"1", "/", 
             RowBox[{"(", 
              RowBox[{"\[Omega]", " ", "q"}], ")"}]}], "-", "2", "+", 
            RowBox[{"2", " ", 
             RowBox[{"Sqrt", "[", 
              RowBox[{"1", "+", 
               RowBox[{"1", "/", 
                RowBox[{"(", 
                 RowBox[{"\[Omega]", " ", "q"}], ")"}]}]}], "]"}]}]}], 
           "]"}]}], "}"}]}], "}"}]}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Steady", "-", 
     RowBox[{"state", " ", "conditional", " ", "variances"}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Xi]", "=", 
     RowBox[{"Sqrt", "[", 
      RowBox[{"1", "+", 
       RowBox[{"4", " ", "\[Eta]", " ", 
        RowBox[{
         RowBox[{"\[CapitalGamma]", "^", "2"}], "/", 
         RowBox[{"\[Omega]", "^", "2"}]}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Vxx", "=", 
     RowBox[{"2", "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Sqrt", "[", 
         RowBox[{"2", " ", "\[Eta]"}], "]"}], " ", 
        RowBox[{"Sqrt", "[", 
         RowBox[{"\[Xi]", "+", "1"}], "]"}]}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Vpp", "=", 
     RowBox[{"2", " ", 
      RowBox[{"\[Xi]", "/", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Sqrt", "[", 
          RowBox[{"2", " ", "\[Eta]"}], "]"}], " ", 
         RowBox[{"Sqrt", "[", 
          RowBox[{"\[Xi]", "+", "1"}], "]"}]}], ")"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Cxp", "=", 
     RowBox[{
      RowBox[{"Sqrt", "[", 
       RowBox[{"\[Xi]", "-", "1"}], "]"}], "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Sqrt", "[", "\[Eta]", "]"}], " ", 
        RowBox[{"Sqrt", "[", 
         RowBox[{"\[Xi]", "+", "1"}], "]"}]}], ")"}]}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Noise", " ", "vector", " ", "and", " ", "diffusion", " ", "matrix"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Gvec", "=", 
     RowBox[{
      RowBox[{"Sqrt", "[", 
       RowBox[{"2", " ", "\[Eta]", " ", "\[CapitalGamma]"}], "]"}], " ", 
      RowBox[{"{", 
       RowBox[{"Vxx", ",", "Cxp"}], "}"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Dmat", "=", 
     RowBox[{"Outer", "[", 
      RowBox[{"Times", ",", "Gvec", ",", "Gvec"}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Drift", " ", "matrix", " ", "with", " ", "feedback"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"M", "=", 
     RowBox[{"A", "-", 
      RowBox[{"B", ".", "K"}]}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Solve", " ", "Lyapunov", " ", 
      RowBox[{"equation", ":", 
       RowBox[{
        RowBox[{"M", ".", "\[CapitalSigma]"}], "+", 
        RowBox[{"\[CapitalSigma]", ".", 
         RowBox[{"M", "^", "T"}]}], "+", "Dmat"}]}]}], "=", "0"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[CapitalSigma]", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\[Sigma]xx", ",", "\[Sigma]xp"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Sigma]xp", ",", "\[Sigma]pp"}], "}"}]}], "}"}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"lyapunov", "=", 
     RowBox[{
      RowBox[{"M", ".", "\[CapitalSigma]"}], "+", 
      RowBox[{"\[CapitalSigma]", ".", 
       RowBox[{"Transpose", "[", "M", "]"}]}], "+", "Dmat"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sol", "=", 
     RowBox[{
      RowBox[{"Solve", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"lyapunov", "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", "1"}], "]"}], "]"}], "==", "0"}], ",", 
          RowBox[{
           RowBox[{"lyapunov", "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", "2"}], "]"}], "]"}], "==", "0"}], ",", 
          RowBox[{
           RowBox[{"lyapunov", "[", 
            RowBox[{"[", 
             RowBox[{"2", ",", "2"}], "]"}], "]"}], "==", "0"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\[Sigma]xx", ",", "\[Sigma]xp", ",", "\[Sigma]pp"}], 
         "}"}]}], "]"}], "//", "FullSimplify"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[CapitalSigma]sol", "=", 
     RowBox[{
      RowBox[{"\[CapitalSigma]", "/.", " ", 
       RowBox[{"sol", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], "//", "FullSimplify"}]}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Total", " ", "unconditional", " ", "variances"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"VxxTotal", "=", 
     RowBox[{"Vxx", "+", 
      RowBox[{"\[CapitalSigma]sol", "[", 
       RowBox[{"[", 
        RowBox[{"1", ",", "1"}], "]"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"VppTotal", "=", 
     RowBox[{"Vpp", "+", 
      RowBox[{"\[CapitalSigma]sol", "[", 
       RowBox[{"[", 
        RowBox[{"2", ",", "2"}], "]"}], "]"}]}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Mean", " ", "phonon", " ", "number"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"nbar", "=", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"VxxTotal", "+", "VppTotal"}], ")"}], "/", "4"}], "-", 
       RowBox[{"1", "/", "2"}]}], "//", "FullSimplify"}]}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{3.981661015417454*^9, 3.981661015419433*^9}, {
